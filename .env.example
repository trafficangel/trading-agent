# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Webhook security ---
# Random ≥ 32 chars. Used in URL: /webhook/luxalgo/<WEBHOOK_SECRET>
WEBHOOK_SECRET=replace_with_openssl_rand_hex_32

# --- Database ---
DB_PATH=./data/trading.sqlite

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHANNEL_SIGNALS=-1001234567890
TELEGRAM_CHANNEL_LOGS=-1001234567891

# --- Track C — LuxAlgo Strategy Builder webhook trader ---
# Master switch for the strategy-trader. Default off.
TRACK_C_ENABLED=false

# --- Trading mode ---
# telemetry | shadow | paper | semi_auto | full_auto
MODE=telemetry

# --- Landing page base URL (optional) ---
# Override only when running a staging instance; production defaults to
# https://robotclaude.biz.
# LANDING_BASE_URL=https://robotclaude.biz
