# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Webhook security ---
# Random ≥ 32 chars. Used in URL: /webhook/luxalgo/<WEBHOOK_SECRET>
WEBHOOK_SECRET=replace_with_openssl_rand_hex_32

# --- Database ---
DB_PATH=./data/trading.sqlite

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_CHANNEL_SIGNALS=-1001234567890
TELEGRAM_CHANNEL_LOGS=-1001234567891

# --- Anthropic (used from Stage 2) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Bybit (used from Stage 3) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# --- Risk limits (override defaults if needed) ---
RISK_PCT_PER_TRADE=0.5
MAX_OPEN_POSITIONS=3
DAILY_DD_LIMIT_PCT=2.0
COOLDOWN_MIN_SAME_SYMBOL=15

# --- Trading mode ---
# telemetry | shadow | paper | semi_auto | full_auto
MODE=telemetry

# --- Symbols (comma-separated, used for aggregator filtering) ---
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
