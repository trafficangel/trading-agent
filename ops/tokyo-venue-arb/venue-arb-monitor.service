[Unit]
Description=Robot Claude Tokyo Extended/Lighter arbitrage radar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/venue-arb-tokyo
Environment=VENUE_ARB_DATA_DIR=/home/trader/apps/venue-arb-tokyo/data
Environment=VENUE_ARB_ACTIVE_VENUES=extended,lighter
Environment=VENUE_ARB_SAMPLE_MS=100
Environment=VENUE_ARB_STALE_MS=250
Environment=VENUE_ARB_EXECUTION_BUFFER_BPS=2
Environment=VENUE_ARB_MAKER_NOTIONAL_USD=100
Environment=VENUE_ARB_MAKER_ENTRY_EDGE_BPS=5
Environment=VENUE_ARB_MAKER_CANCEL_EDGE_BPS=3
Environment=VENUE_ARB_MAKER_POST_FILL_NET_BPS=2
Environment=VENUE_ARB_MAKER_EXIT_NET_BPS=5
Environment=VENUE_ARB_MAKER_QUOTE_LATENCY_MS=60
Environment=VENUE_ARB_MAKER_HEDGE_LATENCY_MS=60
Environment=VENUE_ARB_MAKER_QUOTE_TTL_MS=60000
Environment=VENUE_ARB_MAKER_MAX_QUEUE_USD=5000
Environment=VENUE_ARB_MAKER_HEDGE_GRACE_MS=500
Environment=VENUE_ARB_MAKER_MAX_HOLD_MS=900000
Environment=VENUE_ARB_MAKER_INDEPENDENCE_MS=300000
Environment=VENUE_ARB_FEED_STALL_MS=15000
ExecStart=/usr/bin/node /home/trader/apps/venue-arb-tokyo/dist/hft/venue-arb-monitor.js
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/apps/venue-arb-tokyo/data
MemoryMax=192M
CPUQuota=45%

[Install]
WantedBy=multi-user.target
