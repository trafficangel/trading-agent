[Unit]
Description=Sync Tokyo venue-arb live telemetry to dashboard VPS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
Environment=HOME=/home/trader
ExecStart=/home/trader/apps/venue-arb-tokyo/status-sync.sh
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/.ssh
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=32M

[Install]
WantedBy=multi-user.target
