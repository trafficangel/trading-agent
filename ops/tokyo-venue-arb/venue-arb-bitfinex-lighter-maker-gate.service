[Unit]
Description=Evaluate Bitfinex maker/Lighter taker zero-fee arbitrage shadow
After=venue-arb-bitfinex-lighter-shadow.service

[Service]
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/venue-arb-tokyo
Environment=VENUE_ARB_GATE_DATA_DIR=/home/trader/apps/venue-arb-tokyo/data/bitfinex-lighter-shadow
Environment=VENUE_ARB_GATE_INPUT_FILE=bitfinex-lighter-maker-partial-shadow-v1.ndjson
Environment=VENUE_ARB_GATE_EVENTS_FILE=bitfinex-lighter-maker-partial-events-v1.ndjson
Environment=VENUE_ARB_GATE_OUTPUT_FILE=bitfinex-lighter-maker-partial-gate-status.json
Environment=VENUE_ARB_GATE_ROUTE=bitfinex-maker-lighter-partial
Environment=VENUE_ARB_GATE_NOTIONAL_USD=1000
Environment=VENUE_ARB_GATE_MIN_SAMPLES=30
Environment=VENUE_ARB_GATE_MIN_PROFIT_FACTOR=1.2
Environment=VENUE_ARB_GATE_MAX_DRAWDOWN_BPS=50
Environment=VENUE_ARB_GATE_INDEPENDENCE_MS=60000
Environment=VENUE_ARB_GATE_NO_GO_AFTER_HOURS=4
Environment=VENUE_ARB_GATE_HARD_NO_GO_AFTER_HOURS=4
Environment=VENUE_ARB_GATE_MIN_TRADES_BY_DEADLINE=3
Environment=VENUE_ARB_GATE_MAX_TECHNICAL_FAILURES=0
Environment=VENUE_ARB_GATE_MAX_ACTIVATED_QUOTES_WITHOUT_PROGRESS=100
Environment=VENUE_ARB_GATE_MAX_ACTIVATED_EXPOSURE_WITHOUT_PROGRESS_MS=1800000
ExecStart=/usr/bin/python3 /home/trader/apps/venue-arb-tokyo/venue-arb-shadow-gate.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/apps/venue-arb-tokyo/data/bitfinex-lighter-shadow
