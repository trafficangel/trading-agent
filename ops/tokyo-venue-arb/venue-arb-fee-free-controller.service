[Unit]
Description=Stop fee-free arbitrage shadows after confirmed NO-GO
After=venue-arb-aster-lighter-maker-gate.service
After=venue-arb-extended-lighter-maker-gate.service
After=venue-arb-grvt-lighter-maker-gate.service
After=venue-arb-hibachi-lighter-maker-gate.service
After=venue-arb-hibachi-lighter-capacity-gate.service
After=venue-arb-hibachi-lighter-sticky-gate.service
After=venue-arb-hibachi-lighter-sticky-capacity-gate.service
After=venue-arb-coinbase-lighter-maker-gate.service
After=venue-arb-ethereal-lighter-maker-gate.service
After=venue-arb-hotstuff-lighter-maker-gate.service

[Service]
Type=oneshot
WorkingDirectory=/home/trader/apps/venue-arb-tokyo
Environment=VENUE_ARB_CONTROLLER_GRVT_DISABLED=true
Environment=VENUE_ARB_CONTROLLER_HIBACHI_STICKY_ENABLED=true
Environment=VENUE_ARB_CONTROLLER_COINBASE_DISABLED=true
Environment=VENUE_ARB_CONTROLLER_ETHEREAL_DISABLED=true
Environment=VENUE_ARB_CONTROLLER_HOTSTUFF_DISABLED=true
ExecStart=/usr/bin/python3 /home/trader/apps/venue-arb-tokyo/venue-arb-fee-free-controller.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/home/trader/apps/venue-arb-tokyo/data
