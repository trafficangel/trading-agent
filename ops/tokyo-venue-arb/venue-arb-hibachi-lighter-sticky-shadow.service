[Unit]
Description=Robot Claude Hibachi sticky-maker/Lighter fee-free shadow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/venue-arb-tokyo
Environment=VENUE_ARB_DATA_DIR=/home/trader/apps/venue-arb-tokyo/data/hibachi-lighter-sticky-shadow
Environment=VENUE_ARB_ACTIVE_VENUES=hibachi,lighter
Environment=VENUE_ARB_ACTIVE_COINS=SUI
Environment=VENUE_ARB_SAMPLE_MS=100
Environment=VENUE_ARB_STALE_MS=1500
Environment=VENUE_ARB_EXECUTION_BUFFER_BPS=2
Environment=VENUE_ARB_SHADOW_NOTIONAL_USD=100
Environment=VENUE_ARB_SHADOW_ENTRY_NET_BPS=10000
Environment=VENUE_ARB_SHADOW_BASIS_GATE_ENABLED=true
Environment=VENUE_ARB_SHADOW_BASIS_WINDOW_MS=1800000
Environment=VENUE_ARB_SHADOW_BASIS_EXCLUDE_MS=5000
Environment=VENUE_ARB_SHADOW_BASIS_SAMPLE_MS=1000
Environment=VENUE_ARB_SHADOW_BASIS_MIN_SAMPLES=120
Environment=VENUE_ARB_SHADOW_BASIS_MIN_SPAN_MS=120000
Environment=VENUE_ARB_SHADOW_BASIS_MIN_DEVIATION_BPS=5
Environment=VENUE_ARB_SHADOW_EXECUTION_FRESH_MS=1000
Environment=VENUE_ARB_SHADOW_SOURCE_FRESH_MS=1500
Environment=VENUE_ARB_SHADOW_REQUIRED_SAMPLES=30
Environment=VENUE_ARB_SHADOW_REQUIRED_PASS_PCT=60
Environment=VENUE_ARB_SHADOW_INDEPENDENCE_MS=60000
Environment=VENUE_ARB_MAKER_INDEPENDENCE_MS=60000
Environment=VENUE_ARB_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_GRVT_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_GRVT_EXTENDED_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_EXTENDED_ASTER_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_ASTER_BINANCE_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_ASTER_PACIFICA_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_ASTER_LIGHTER_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_EXTENDED_LIGHTER_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_EXTENDED_PACIFICA_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_LIGHTER_EXTENDED_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_HIBACHI_LIGHTER_MAKER_SHADOW_ENABLED=true
Environment=VENUE_ARB_HIBACHI_LIGHTER_MAKER_NOTIONAL_USD=100
Environment=VENUE_ARB_HIBACHI_LIGHTER_CAPACITY_SHADOW_ENABLED=true
Environment=VENUE_ARB_HIBACHI_LIGHTER_CAPACITY_NOTIONAL_USD=1000
Environment=VENUE_ARB_HIBACHI_LIGHTER_MAKER_ENTRY_EDGE_BPS=1
# Keep the quote resting through a temporary edge reversal. Five-minute quotes
# are still capped by the gate's exact 25-minute cumulative exposure budget.
Environment=VENUE_ARB_HIBACHI_LIGHTER_MAKER_CANCEL_EDGE_BPS=-20
Environment=VENUE_ARB_HIBACHI_LIGHTER_MAKER_POST_FILL_NET_BPS=0.5
Environment=VENUE_ARB_HIBACHI_LIGHTER_MAKER_EXIT_NET_BPS=1
Environment=VENUE_ARB_HIBACHI_LIGHTER_MAKER_QUOTE_LATENCY_MS=250
Environment=VENUE_ARB_HIBACHI_LIGHTER_MAKER_HEDGE_LATENCY_MS=300
Environment=VENUE_ARB_HIBACHI_LIGHTER_MAKER_QUOTE_TTL_MS=300000
Environment=VENUE_ARB_HIBACHI_LIGHTER_MAKER_MAINTAIN_BELOW_ENTRY_GATE=true
Environment=VENUE_ARB_HIBACHI_LIGHTER_MAKER_MAX_QUEUE_USD=500
Environment=VENUE_ARB_HIBACHI_LIGHTER_MAKER_QUOTE_DATA_GRACE_MS=500
Environment=VENUE_ARB_HIBACHI_LIGHTER_MAKER_MAX_TRADE_IDLE_MS=10000
Environment=VENUE_ARB_MAKER_MAX_HOLD_MS=900000
Environment=VENUE_ARB_MAKER_MIN_RAW_ENTRY_NET_BPS=5
Environment=VENUE_ARB_MAKER_EXIT_QUOTE_DATA_GRACE_MS=5000
Environment=VENUE_ARB_MAKER_EXIT_QUOTE_TTL_MS=900000
Environment=VENUE_ARB_FEE_BPS_HIBACHI=4.5
Environment=VENUE_ARB_LIGHTER_TRADE_COINS=SUI
Environment=VENUE_ARB_LIGHTER_BOOK_REFRESH_MS=0
Environment=VENUE_ARB_LIGHTER_MARKETS_PER_CONNECTION=6
Environment=VENUE_ARB_LIGHTER_BBO_MISMATCH_REFRESH_COUNT=0
Environment=VENUE_ARB_LIGHTER_REST_BOOK_ENABLED=true
Environment=VENUE_ARB_LIGHTER_REST_ACTIVE_QUOTE_ONLY=true
Environment=VENUE_ARB_LIGHTER_REST_BOOK_INTERVAL_MS=250
Environment=VENUE_ARB_LIGHTER_REST_BOOK_LIMIT=50
Environment=VENUE_ARB_LIGHTER_REST_BOOK_TIMEOUT_MS=2000
Environment=VENUE_ARB_LIGHTER_VALIDATED_BOOK_FRESH_MS=1000
Environment=VENUE_ARB_EXECUTION_CANDIDATE_FRESH_MS=3000
Environment=VENUE_ARB_FEED_STALL_MS=15000
ExecStart=/usr/bin/node /home/trader/apps/venue-arb-tokyo/dist/hft/venue-arb-monitor.js
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/apps/venue-arb-tokyo/data/hibachi-lighter-sticky-shadow
MemoryMax=128M
CPUQuota=90%

[Install]
WantedBy=multi-user.target
