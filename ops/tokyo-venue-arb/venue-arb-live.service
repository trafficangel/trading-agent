[Unit]
Description=Robot Claude Tokyo protected Extended/Lighter arbitrage canary
After=network-online.target venue-arb-monitor.service
Wants=network-online.target venue-arb-monitor.service

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/venue-arb-tokyo
EnvironmentFile=/etc/venue-arb-tokyo/extended.env
EnvironmentFile=/etc/venue-arb-tokyo/lighter.env
Environment=VENUE_ARB_DATA_DIR=/home/trader/apps/venue-arb-tokyo/data/candidate-routes
Environment=VENUE_ARB_LIVE_REGION=Tokyo
Environment=VENUE_ARB_LIVE_ENABLED=true
Environment=VENUE_ARB_LIVE_EXECUTION=taker-taker
Environment=VENUE_ARB_LIVE_ROUTE=extended-lighter
Environment=VENUE_ARB_LIVE_ALLOWED_COINS=BTC,ETH,SOL,HYPE,XRP,DOGE,ADA,BNB,LTC
Environment=VENUE_ARB_LIVE_NOTIONAL_USD=100
Environment=VENUE_ARB_LIVE_LEVERAGE=5
Environment=VENUE_ARB_LIVE_ENTRY_NET_BPS=10
Environment=VENUE_ARB_LIVE_ENTRY_CONFIRMATIONS=3
Environment=VENUE_ARB_LIVE_BASIS_GATE_ENABLED=true
Environment=VENUE_ARB_LIVE_BASIS_WINDOW_SECONDS=1800
Environment=VENUE_ARB_LIVE_BASIS_EXCLUDE_SECONDS=5
Environment=VENUE_ARB_LIVE_BASIS_MIN_SAMPLES=120
Environment=VENUE_ARB_LIVE_BASIS_MIN_SPAN_SECONDS=120
Environment=VENUE_ARB_LIVE_BASIS_MIN_DEVIATION_BPS=10
Environment=VENUE_ARB_LIVE_MAKER_CANCEL_NET_BPS=5
Environment=VENUE_ARB_LIVE_POST_FILL_NET_BPS=5
Environment=VENUE_ARB_LIVE_EXIT_MIN_PROFIT_BPS=2
Environment=VENUE_ARB_LIVE_EXIT_CONFIRMATIONS=3
Environment=VENUE_ARB_LIVE_EXTENDED_TAKER_BPS=2.5
Environment=VENUE_ARB_LIVE_LIGHTER_TAKER_BPS=0
Environment=VENUE_ARB_LIVE_FRESH_MS=150
Environment=VENUE_ARB_LIVE_SOURCE_FRESH_MS=750
Environment=VENUE_ARB_LIVE_ENTRY_SLIPPAGE=0.0002
Environment=VENUE_ARB_LIVE_EXIT_SLIPPAGE=0.001
Environment=VENUE_ARB_LIVE_EMERGENCY_SLIPPAGE=0.01
Environment=VENUE_ARB_LIVE_MAX_HOLD_MS=180000
Environment=VENUE_ARB_LIVE_MAX_ADVERSE_BPS=10
Environment=VENUE_ARB_LIVE_MAX_LOSS_USD=0.20
Environment=VENUE_ARB_LIVE_FUNDING_BPS_PER_HOUR=1
Environment=VENUE_ARB_LIVE_MAKER_MAX_QUEUE_USD=5000
Environment=VENUE_ARB_LIVE_MAKER_MIN_TTL_MS=5000
Environment=VENUE_ARB_LIVE_MAKER_ORDER_TTL_MS=60000
Environment=VENUE_ARB_LIVE_MAKER_SAFETY_TICKS=1
Environment=VENUE_ARB_LIVE_MAKER_SAFETY_BPS=0
Environment=VENUE_ARB_LIVE_MAKER_RETRY_COOLDOWN_MS=5000
Environment=VENUE_ARB_LIVE_MAX_TRADES=1
Environment=VENUE_ARB_LIVE_REQUIRE_MAKER_SHADOW_PASSES=0
Environment=VENUE_ARB_LIVE_DAILY_LOSS_USD=2
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/trader/venvs/venue-arb-tokyo/bin/python /home/trader/apps/venue-arb-tokyo/venue-arb-live.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=16min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/apps/venue-arb-tokyo/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
