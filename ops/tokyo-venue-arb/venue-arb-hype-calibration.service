[Unit]
Description=Robot Claude Tokyo Extended/Lighter cross-coin threshold calibration
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/venue-arb-tokyo
Environment=VENUE_ARB_DATA_DIR=/home/trader/apps/venue-arb-tokyo/data/extended-lighter-3bps
Environment=VENUE_ARB_ACTIVE_VENUES=extended,lighter
Environment=VENUE_ARB_SAMPLE_MS=100
Environment=VENUE_ARB_STALE_MS=250
Environment=VENUE_ARB_NET_TRIGGER_BPS=1
Environment=VENUE_ARB_EXECUTION_BUFFER_BPS=2
Environment=VENUE_ARB_SHADOW_NOTIONAL_USD=100
Environment=VENUE_ARB_SHADOW_ENTRY_NET_BPS=3
Environment=VENUE_ARB_SHADOW_ENTRY_CONFIRMATIONS=3
Environment=VENUE_ARB_SHADOW_BASIS_GATE_ENABLED=true
Environment=VENUE_ARB_SHADOW_BASIS_WINDOW_MS=1800000
Environment=VENUE_ARB_SHADOW_BASIS_EXCLUDE_MS=5000
Environment=VENUE_ARB_SHADOW_BASIS_SAMPLE_MS=1000
Environment=VENUE_ARB_SHADOW_BASIS_MIN_SAMPLES=120
Environment=VENUE_ARB_SHADOW_BASIS_MIN_SPAN_MS=120000
Environment=VENUE_ARB_SHADOW_BASIS_MIN_DEVIATION_BPS=10
Environment=VENUE_ARB_SHADOW_EXIT_NET_BPS=2
Environment=VENUE_ARB_SHADOW_EXIT_CONFIRMATIONS=3
Environment=VENUE_ARB_SHADOW_ENTRY_LATENCY_FLOOR_MS=150
Environment=VENUE_ARB_SHADOW_EXIT_LATENCY_FLOOR_MS=200
Environment=VENUE_ARB_SHADOW_MAX_HOLD_MS=180000
Environment=VENUE_ARB_SHADOW_MIN_HOLD_MS=200
Environment=VENUE_ARB_SHADOW_MAX_LOSS_BPS=5
Environment=VENUE_ARB_SHADOW_FUNDING_BPS_PER_HOUR=1
Environment=VENUE_ARB_SHADOW_INDEPENDENCE_MS=60000
Environment=VENUE_ARB_SHADOW_REQUIRED_SAMPLES=20
Environment=VENUE_ARB_SHADOW_REQUIRED_PASS_PCT=90
Environment=VENUE_ARB_LIGHTER_BOOK_REFRESH_MS=30000
Environment=VENUE_ARB_LIGHTER_BBO_MISMATCH_BPS=2
Environment=VENUE_ARB_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_GRVT_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_GRVT_EXTENDED_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_EXTENDED_ASTER_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_LIGHTER_EXTENDED_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_FEED_STALL_MS=15000
ExecStart=/usr/bin/node /home/trader/apps/venue-arb-tokyo/dist/hft/venue-arb-monitor.js
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/apps/venue-arb-tokyo/data
MemoryMax=96M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
