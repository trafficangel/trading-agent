[Unit]
Description=Evaluate Extended maker/Lighter taker arbitrage shadow profit gate
After=venue-arb-extended-lighter-shadow.service

[Service]
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/venue-arb-tokyo
Environment=VENUE_ARB_GATE_DATA_DIR=/home/trader/apps/venue-arb-tokyo/data/extended-lighter-shadow
Environment=VENUE_ARB_GATE_INPUT_FILE=extended-lighter-maker-basis-shadow-v3.ndjson
Environment=VENUE_ARB_GATE_EVENTS_FILE=extended-lighter-maker-events-v2.ndjson
Environment=VENUE_ARB_GATE_OUTPUT_FILE=extended-lighter-maker-gate-status.json
Environment=VENUE_ARB_GATE_ROUTE=extended-maker-lighter
Environment=VENUE_ARB_GATE_NOTIONAL_USD=100
Environment=VENUE_ARB_GATE_MIN_SAMPLES=30
Environment=VENUE_ARB_GATE_MIN_PROFIT_FACTOR=1.2
Environment=VENUE_ARB_GATE_MAX_DRAWDOWN_BPS=50
Environment=VENUE_ARB_GATE_INDEPENDENCE_MS=60000
# No activated quote after two hours is enough evidence that this route does
# not currently offer executable positive edge.
Environment=VENUE_ARB_GATE_NO_GO_AFTER_HOURS=2
Environment=VENUE_ARB_GATE_HARD_NO_GO_AFTER_HOURS=2
Environment=VENUE_ARB_GATE_MAX_ACTIVATED_QUOTES_WITHOUT_PROGRESS=100
Environment=VENUE_ARB_GATE_REQUIRE_TRADE_THROUGH_FILLS=false
ExecStart=/usr/bin/python3 /home/trader/apps/venue-arb-tokyo/venue-arb-shadow-gate.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/apps/venue-arb-tokyo/data/extended-lighter-shadow
