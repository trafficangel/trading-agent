[Unit]
Description=Evaluate $1,000 Hibachi sticky-maker/Lighter capacity shadow profit gate
After=venue-arb-hibachi-lighter-sticky-shadow.service

[Service]
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/venue-arb-tokyo
Environment=VENUE_ARB_GATE_DATA_DIR=/home/trader/apps/venue-arb-tokyo/data/hibachi-lighter-sticky-shadow
Environment=VENUE_ARB_GATE_INPUT_FILE=hibachi-lighter-capacity-shadow-v1.ndjson
Environment=VENUE_ARB_GATE_EVENTS_FILE=hibachi-lighter-capacity-events-v1.ndjson
Environment=VENUE_ARB_GATE_OUTPUT_FILE=hibachi-lighter-capacity-gate-status.json
Environment=VENUE_ARB_GATE_ROUTE=hibachi-maker-lighter-capacity
Environment=VENUE_ARB_GATE_NOTIONAL_USD=1000
Environment=VENUE_ARB_GATE_MIN_SAMPLES=30
Environment=VENUE_ARB_GATE_MIN_PROFIT_FACTOR=1.2
Environment=VENUE_ARB_GATE_MAX_DRAWDOWN_BPS=50
Environment=VENUE_ARB_GATE_INDEPENDENCE_MS=60000
Environment=VENUE_ARB_GATE_MAX_ACTIVATED_QUOTES_WITHOUT_PROGRESS=25
Environment=VENUE_ARB_GATE_REQUIRE_TRADE_THROUGH_FILLS=true
ExecStart=/usr/bin/python3 /home/trader/apps/venue-arb-tokyo/venue-arb-shadow-gate.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/apps/venue-arb-tokyo/data/hibachi-lighter-sticky-shadow
