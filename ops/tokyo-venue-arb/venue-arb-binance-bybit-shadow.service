Environment=VENUE_ARB_ASTER_LIGHTER_MAKER_NOTIONAL_USD=100
Environment=VENUE_ARB_ASTER_LIGHTER_MAKER_ENTRY_EDGE_BPS=1
Environment=VENUE_ARB_ASTER_LIGHTER_MAKER_CANCEL_EDGE_BPS=0.5
Environment=VENUE_ARB_ASTER_LIGHTER_MAKER_POST_FILL_NET_BPS=0.5
