[Unit]
Description=Robot Claude targeted CEX/Aster/Pacifica arbitrage shadow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/venue-arb-tokyo
Environment=VENUE_ARB_DATA_DIR=/home/trader/apps/venue-arb-tokyo/data/binance-bybit-shadow
Environment=VENUE_ARB_ACTIVE_VENUES=aster,lighter
Environment=VENUE_ARB_ACTIVE_COINS=LIT,BTC,ETH,SOL,HYPE,XRP,ADA,BNB,ZEC,PUMP,ENA,NEAR,DOGE,UNI,AAVE,LTC,XMR,XPL,JUP
Environment=VENUE_ARB_SAMPLE_MS=100
