Environment=VENUE_ARB_EXTENDED_ASTER_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_ASTER_BINANCE_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_ASTER_BINANCE_MAKER_NOTIONAL_USD=100
Environment=VENUE_ARB_ASTER_BINANCE_MAKER_ENTRY_EDGE_BPS=1
Environment=VENUE_ARB_ASTER_BINANCE_MAKER_CANCEL_EDGE_BPS=0.5
Environment=VENUE_ARB_ASTER_BINANCE_MAKER_POST_FILL_NET_BPS=0.5
Environment=VENUE_ARB_ASTER_BINANCE_MAKER_EXIT_NET_BPS=1
Environment=VENUE_ARB_ASTER_BINANCE_MAKER_QUOTE_LATENCY_MS=250
Environment=VENUE_ARB_ASTER_BINANCE_MAKER_HEDGE_LATENCY_MS=100
Environment=VENUE_ARB_ASTER_PACIFICA_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_ASTER_PACIFICA_MAKER_NOTIONAL_USD=100
