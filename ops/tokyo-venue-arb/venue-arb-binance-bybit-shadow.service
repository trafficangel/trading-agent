Environment=VENUE_ARB_LIGHTER_VALIDATED_BOOK_FRESH_MS=1000
Environment=VENUE_ARB_EXTENDED_LIGHTER_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_EXTENDED_PACIFICA_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_LIGHTER_EXTENDED_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_FEED_STALL_MS=15000
ExecStart=/usr/bin/node /home/trader/apps/venue-arb-tokyo/dist/hft/venue-arb-monitor.js
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/apps/venue-arb-tokyo/data/binance-bybit-shadow
MemoryMax=192M
CPUQuota=60%

[Install]
WantedBy=multi-user.target
