Environment=VENUE_ARB_MAKER_BOOK_FRESH_MS=1000
Environment=VENUE_ARB_MAKER_MAX_HOLD_MS=180000
Environment=VENUE_ARB_MAKER_INDEPENDENCE_MS=60000
Environment=VENUE_ARB_GRVT_MAKER_MAX_QUEUE_USD=5000
Environment=VENUE_ARB_GRVT_MAKER_QUOTE_TTL_MS=60000
Environment=VENUE_ARB_LIGHTER_BOOK_REFRESH_MS=0
Environment=VENUE_ARB_LIGHTER_MARKETS_PER_CONNECTION=8
Environment=VENUE_ARB_LIGHTER_BBO_MISMATCH_REFRESH_COUNT=0
