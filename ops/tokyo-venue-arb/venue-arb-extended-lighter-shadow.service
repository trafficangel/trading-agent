[Unit]
Description=Robot Claude targeted Extended maker/Lighter taker arbitrage shadow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/venue-arb-tokyo
Environment=VENUE_ARB_DATA_DIR=/home/trader/apps/venue-arb-tokyo/data/extended-lighter-shadow
Environment=VENUE_ARB_ACTIVE_VENUES=extended,grvt,lighter
# LIT is excluded: its Lighter depth disagreed with the independent ticker in
# roughly 23% of checks and produced both the prior failed-flat live canary and
# a negative reverse shadow fill. Prefer the better-validated books below.
# The only completed positive cycles on both Extended and GRVT used HYPE.
# Focus the clean forward cohort there so unrelated books cannot occupy either
# route's single maker slot. The gate still requires 30 new episodes.
Environment=VENUE_ARB_ACTIVE_COINS=HYPE
Environment=VENUE_ARB_SAMPLE_MS=100
Environment=VENUE_ARB_STALE_MS=1000
Environment=VENUE_ARB_EXECUTION_BUFFER_BPS=2
Environment=VENUE_ARB_SHADOW_NOTIONAL_USD=100
# Disable paid taker-taker entries in this process. The focused cohort below
# keeps only zero/rebate maker -> zero-fee Lighter taker routes active.
Environment=VENUE_ARB_SHADOW_ENTRY_NET_BPS=10000
Environment=VENUE_ARB_SHADOW_ENTRY_CONFIRMATIONS=3
Environment=VENUE_ARB_SHADOW_ENTRY_CONFIRMATION_GRACE_MS=1000
Environment=VENUE_ARB_SHADOW_BASIS_GATE_ENABLED=true
Environment=VENUE_ARB_SHADOW_BASIS_WINDOW_MS=1800000
Environment=VENUE_ARB_SHADOW_BASIS_EXCLUDE_MS=5000
Environment=VENUE_ARB_SHADOW_BASIS_SAMPLE_MS=1000
Environment=VENUE_ARB_SHADOW_BASIS_MIN_SAMPLES=120
Environment=VENUE_ARB_SHADOW_BASIS_MIN_SPAN_MS=120000
Environment=VENUE_ARB_SHADOW_BASIS_MIN_DEVIATION_BPS=10
Environment=VENUE_ARB_SHADOW_EXIT_NET_BPS=2
Environment=VENUE_ARB_SHADOW_EXIT_CONFIRMATIONS=3
Environment=VENUE_ARB_SHADOW_SIGNAL_FRESH_MS=1000
Environment=VENUE_ARB_SHADOW_EXECUTION_FRESH_MS=1000
Environment=VENUE_ARB_SHADOW_SOURCE_FRESH_MS=1000
Environment=VENUE_ARB_SHADOW_ENTRY_LATENCY_FLOOR_MS=1200
Environment=VENUE_ARB_SHADOW_EXIT_LATENCY_FLOOR_MS=1200
Environment=VENUE_ARB_SHADOW_MAX_HOLD_MS=180000
Environment=VENUE_ARB_SHADOW_MIN_HOLD_MS=500
Environment=VENUE_ARB_SHADOW_MAX_LOSS_BPS=20
Environment=VENUE_ARB_SHADOW_INDEPENDENCE_MS=60000
Environment=VENUE_ARB_SHADOW_REQUIRED_SAMPLES=30
Environment=VENUE_ARB_SHADOW_REQUIRED_PASS_PCT=60
Environment=VENUE_ARB_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_GRVT_MAKER_SHADOW_ENABLED=true
Environment=VENUE_ARB_GRVT_MAKER_NOTIONAL_USD=100
Environment=VENUE_ARB_GRVT_MAKER_ENTRY_EDGE_BPS=5
Environment=VENUE_ARB_GRVT_MAKER_CANCEL_EDGE_BPS=3
Environment=VENUE_ARB_GRVT_MAKER_POST_FILL_NET_BPS=2
Environment=VENUE_ARB_GRVT_MAKER_EXIT_NET_BPS=1
Environment=VENUE_ARB_GRVT_MAKER_QUOTE_LATENCY_MS=200
Environment=VENUE_ARB_GRVT_MAKER_HEDGE_LATENCY_MS=300
Environment=VENUE_ARB_GRVT_MAKER_MAX_QUEUE_USD=500
Environment=VENUE_ARB_GRVT_MAKER_QUOTE_DATA_GRACE_MS=600
Environment=VENUE_ARB_GRVT_MAKER_FEE_BPS=-0.01
Environment=VENUE_ARB_GRVT_MAKER_MAX_TRADE_IDLE_MS=15000
Environment=VENUE_ARB_MAKER_MAX_HOLD_MS=900000
Environment=VENUE_ARB_MAKER_MIN_RAW_ENTRY_NET_BPS=5
Environment=VENUE_ARB_MAKER_EXIT_QUOTE_DATA_GRACE_MS=5000
Environment=VENUE_ARB_MAKER_EXIT_QUOTE_TTL_MS=900000
Environment=VENUE_ARB_GRVT_EXTENDED_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_EXTENDED_ASTER_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_EXTENDED_LIGHTER_MAKER_SHADOW_ENABLED=true
# The 4.59 bps fill realized +10.30 bps, while the later 1.05 bps fill lost
# 9.37 bps when its hedge disappeared. The strict cohort therefore requires
# enough edge to absorb adverse selection instead of optimizing quote count.
Environment=VENUE_ARB_EXTENDED_LIGHTER_MAKER_ENTRY_EDGE_BPS=3
Environment=VENUE_ARB_EXTENDED_LIGHTER_MAKER_CANCEL_EDGE_BPS=2
Environment=VENUE_ARB_EXTENDED_LIGHTER_MAKER_POST_FILL_NET_BPS=1.5
Environment=VENUE_ARB_EXTENDED_LIGHTER_MAKER_EXIT_NET_BPS=1
Environment=VENUE_ARB_EXTENDED_LIGHTER_MAKER_QUOTE_LATENCY_MS=200
Environment=VENUE_ARB_EXTENDED_LIGHTER_MAKER_HEDGE_LATENCY_MS=300
# Extended-maker and the disabled reverse route currently share this queue
# control in the monitor implementation.
Environment=VENUE_ARB_LIGHTER_EXTENDED_MAKER_MAX_QUEUE_USD=500
Environment=VENUE_ARB_EXTENDED_LIGHTER_MAKER_QUOTE_DATA_GRACE_MS=600
Environment=VENUE_ARB_EXTENDED_LIGHTER_MAKER_MAX_TRADE_IDLE_MS=10000
Environment=VENUE_ARB_LIGHTER_EXTENDED_MAKER_MAX_HOLD_MS=900000
Environment=VENUE_ARB_EXTENDED_PACIFICA_MAKER_SHADOW_ENABLED=false
# Reverse route is structurally weaker: it pays the Extended taker fee after
# a Lighter maker fill and its first completed shadow cycle lost 14.33 bps.
# Keep the strict cohort focused on Extended maker -> Lighter taker.
Environment=VENUE_ARB_LIGHTER_EXTENDED_MAKER_SHADOW_ENABLED=false
Environment=VENUE_ARB_LIGHTER_EXTENDED_MAKER_ENTRY_EDGE_BPS=1
Environment=VENUE_ARB_LIGHTER_EXTENDED_MAKER_CANCEL_EDGE_BPS=0.5
Environment=VENUE_ARB_LIGHTER_EXTENDED_MAKER_POST_FILL_NET_BPS=0.5
Environment=VENUE_ARB_LIGHTER_EXTENDED_MAKER_EXIT_NET_BPS=1
Environment=VENUE_ARB_LIGHTER_EXTENDED_MAKER_QUOTE_LATENCY_MS=200
Environment=VENUE_ARB_LIGHTER_EXTENDED_MAKER_HEDGE_LATENCY_MS=200
Environment=VENUE_ARB_LIGHTER_EXTENDED_MAKER_MAX_TRADE_IDLE_MS=10000
Environment=VENUE_ARB_LIGHTER_TRADE_COINS=HYPE
Environment=VENUE_ARB_LIGHTER_BOOK_REFRESH_MS=0
Environment=VENUE_ARB_LIGHTER_MARKETS_PER_CONNECTION=6
Environment=VENUE_ARB_LIGHTER_BBO_MISMATCH_REFRESH_COUNT=0
Environment=VENUE_ARB_LIGHTER_REST_BOOK_ENABLED=true
Environment=VENUE_ARB_LIGHTER_REST_ACTIVE_QUOTE_ONLY=true
Environment=VENUE_ARB_LIGHTER_REST_BOOK_INTERVAL_MS=250
Environment=VENUE_ARB_LIGHTER_REST_BOOK_LIMIT=50
Environment=VENUE_ARB_LIGHTER_REST_BOOK_TIMEOUT_MS=2000
Environment=VENUE_ARB_LIGHTER_VALIDATED_BOOK_FRESH_MS=1000
Environment=VENUE_ARB_EXECUTION_CANDIDATE_FRESH_MS=3000
Environment=VENUE_ARB_FEED_STALL_MS=15000
Environment=VENUE_ARB_EXTENDED_PER_MARKET_STREAMS=true
ExecStart=/usr/bin/node /home/trader/apps/venue-arb-tokyo/dist/hft/venue-arb-monitor.js
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/apps/venue-arb-tokyo/data/extended-lighter-shadow
MemoryMax=128M
CPUQuota=90%

[Install]
WantedBy=multi-user.target
