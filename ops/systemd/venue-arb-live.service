[Unit]
Description=Robot Claude protected Extended/Lighter arbitrage canary
After=network-online.target venue-arb-monitor.service
Wants=network-online.target venue-arb-monitor.service

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/trading-agent
EnvironmentFile=/etc/trading-agent/extended-arb.env
EnvironmentFile=/etc/trading-agent/lighter-live.env
Environment=VENUE_ARB_DATA_DIR=/home/trader/apps/trading-agent/data/venue-arb
Environment=VENUE_ARB_LIVE_ENABLED=false
Environment=VENUE_ARB_LIVE_EXECUTION=maker-taker
Environment=VENUE_ARB_LIVE_ROUTE=lighter-extended
Environment=VENUE_ARB_LIVE_NOTIONAL_USD=100
Environment=VENUE_ARB_LIVE_LEVERAGE=5
Environment=VENUE_ARB_LIVE_ENTRY_NET_BPS=15
Environment=VENUE_ARB_LIVE_MAKER_CANCEL_NET_BPS=12
Environment=VENUE_ARB_LIVE_POST_FILL_NET_BPS=10
Environment=VENUE_ARB_LIVE_EXIT_MIN_PROFIT_BPS=10
Environment=VENUE_ARB_LIVE_EXIT_CONFIRMATIONS=3
Environment=VENUE_ARB_LIVE_EXTENDED_TAKER_BPS=2.5
Environment=VENUE_ARB_LIVE_FRESH_MS=150
Environment=VENUE_ARB_LIVE_SOURCE_FRESH_MS=750
Environment=VENUE_ARB_LIVE_ENTRY_SLIPPAGE=0.0002
Environment=VENUE_ARB_LIVE_EXIT_SLIPPAGE=0.001
Environment=VENUE_ARB_LIVE_EMERGENCY_SLIPPAGE=0.01
Environment=VENUE_ARB_LIVE_MAX_HOLD_MS=900000
Environment=VENUE_ARB_LIVE_MAX_ADVERSE_BPS=20
Environment=VENUE_ARB_LIVE_MAKER_MAX_QUEUE_USD=5000
Environment=VENUE_ARB_LIVE_MAKER_MIN_TTL_MS=5000
Environment=VENUE_ARB_LIVE_MAKER_ORDER_TTL_MS=60000
Environment=VENUE_ARB_LIVE_MAKER_SAFETY_TICKS=1
Environment=VENUE_ARB_LIVE_MAKER_SAFETY_BPS=0
Environment=VENUE_ARB_LIVE_MAKER_RETRY_COOLDOWN_MS=5000
# Two adverse maker fills are retained in the honest journal. A third and final
# canary is allowed only after the post-fix shadow completes profitably.
Environment=VENUE_ARB_LIVE_MAX_TRADES=3
Environment=VENUE_ARB_LIVE_REQUIRE_MAKER_SHADOW_PASSES=1
Environment=VENUE_ARB_LIVE_DAILY_LOSS_USD=2
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/trader/venvs/venue-arb-live/bin/python /home/trader/apps/trading-agent/scripts/venue-arb-live.py
Restart=on-failure
RestartSec=3
# SIGTERM is deferred while a hedged pair is open. Allow the 15-minute
# max-hold guard to close both legs cleanly instead of SIGKILLing the process.
TimeoutStopSec=16min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/apps/trading-agent/data/venue-arb
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
