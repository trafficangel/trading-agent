[Unit]
Description=Robot Claude read-only DEX/CEX perpetual arbitrage radar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/trading-agent
EnvironmentFile=-/home/trader/apps/trading-agent/.env
Environment=VENUE_ARB_DATA_DIR=/home/trader/apps/trading-agent/data/venue-arb
Environment=VENUE_ARB_SHADOW_NOTIONAL_USD=500
Environment=VENUE_ARB_SHADOW_ENTRY_NET_BPS=10
Environment=VENUE_ARB_SHADOW_ENTRY_CONFIRMATIONS=3
Environment=VENUE_ARB_SHADOW_EXIT_NET_BPS=10
Environment=VENUE_ARB_SHADOW_EXIT_CONFIRMATIONS=3
Environment=VENUE_ARB_SHADOW_FRESH_MS=150
Environment=VENUE_ARB_SHADOW_SOURCE_FRESH_MS=750
Environment=VENUE_ARB_SHADOW_MAX_HOLD_MS=900000
Environment=VENUE_ARB_SHADOW_FUNDING_BPS_PER_HOUR=1
Environment=VENUE_ARB_SHADOW_REQUIRED_SAMPLES=20
Environment=VENUE_ARB_SHADOW_REQUIRED_PASS_PCT=90
Environment=VENUE_ARB_SHADOW_ENTRY_LATENCY_FLOOR_MS=1000
Environment=VENUE_ARB_SHADOW_EXIT_LATENCY_FLOOR_MS=2200
Environment=VENUE_ARB_SHADOW_EXIT_QUOTE_GRACE_MS=1000
Environment=VENUE_ARB_MAKER_NOTIONAL_USD=100
Environment=VENUE_ARB_MAKER_ENTRY_EDGE_BPS=15
Environment=VENUE_ARB_MAKER_CANCEL_EDGE_BPS=12
Environment=VENUE_ARB_MAKER_POST_FILL_NET_BPS=10
Environment=VENUE_ARB_MAKER_EXIT_NET_BPS=10
Environment=VENUE_ARB_MAKER_QUOTE_LATENCY_MS=1000
Environment=VENUE_ARB_MAKER_HEDGE_LATENCY_MS=1000
Environment=VENUE_ARB_MAKER_QUOTE_TTL_MS=60000
Environment=VENUE_ARB_MAKER_MAX_QUEUE_USD=5000
Environment=VENUE_ARB_MAKER_HEDGE_GRACE_MS=2000
Environment=VENUE_ARB_MAKER_MAX_HOLD_MS=900000
Environment=VENUE_ARB_MAKER_INDEPENDENCE_MS=300000
Environment=VENUE_ARB_GRVT_MAKER_NOTIONAL_USD=100
Environment=VENUE_ARB_GRVT_MAKER_ENTRY_EDGE_BPS=5
Environment=VENUE_ARB_GRVT_MAKER_CANCEL_EDGE_BPS=3
Environment=VENUE_ARB_GRVT_MAKER_POST_FILL_NET_BPS=2
Environment=VENUE_ARB_GRVT_MAKER_EXIT_NET_BPS=5
Environment=VENUE_ARB_GRVT_MAKER_QUOTE_LATENCY_MS=1000
Environment=VENUE_ARB_GRVT_MAKER_HEDGE_LATENCY_MS=1000
Environment=VENUE_ARB_GRVT_MAKER_QUOTE_TTL_MS=60000
Environment=VENUE_ARB_GRVT_MAKER_MAX_QUEUE_USD=5000
Environment=VENUE_ARB_GRVT_EXTENDED_MAKER_ENTRY_EDGE_BPS=12
Environment=VENUE_ARB_GRVT_EXTENDED_MAKER_CANCEL_EDGE_BPS=8
Environment=VENUE_ARB_GRVT_EXTENDED_MAKER_POST_FILL_NET_BPS=8
Environment=VENUE_ARB_GRVT_EXTENDED_MAKER_EXIT_NET_BPS=8
Environment=VENUE_ARB_FEED_STALL_MS=15000
ExecStart=/usr/bin/node /home/trader/apps/trading-agent/dist/hft/venue-arb-monitor.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/trader/apps/trading-agent/data/venue-arb
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
