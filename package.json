{
  "name": "trading-agent",
  "version": "0.1.0",
  "private": true,
  "description": "LuxAlgo + Claude vision + Telegram trading agent for Bybit USDT-perp",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/strategies/data && cp -R src/strategies/data/. dist/strategies/data/",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "status": "tsx scripts/status.ts",
    "risk": "tsx scripts/risk-status.ts",
    "backup": "tsx src/ops/sqlite-backup.ts",
    "restore:db": "tsx src/ops/sqlite-restore.ts",
    "hft:history": "node --experimental-strip-types scripts/download-hft-history.ts",
    "hft:tardis:download": "node --experimental-strip-types scripts/download-tardis-hft.ts",
    "hft:tardis:convert": "tsx scripts/convert-tardis-hft.ts",
    "hft:post-shock": "tsx src/hft/post-shock-analyzer.ts",
    "hft:cascade": "tsx src/hft/cascade-leadlag-analyzer.ts",
    "lighter:microstructure": "tsx src/hft/lighter-microstructure-recorder.ts",
    "lighter:micro-audit": "tsx scripts/audit-lighter-microstructure.ts",
    "lighter:micro-sweep": "tsx scripts/sweep-lighter-microstructure.ts",
    "wick:recovery": "tsx scripts/wick-fade-recovery.ts",
    "audit": "tsx scripts/audit-sl-distribution.ts",
    "backtest": "tsx scripts/backtest-custom.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.1",
    "@fastify/static": "^9.1.3",
    "@nktkas/hyperliquid": "^0.32.2",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "node-cron": "^3.0.3",
    "p-limit": "^7.3.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.51.0",
    "undici": "^7.2.0",
    "viem": "^2.52.2",
    "ws": "^8.20.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
