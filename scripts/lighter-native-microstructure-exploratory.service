[Unit]
Description=Exploratory Lighter microstructure strategy sweep
After=lighter-native-microstructure-audit.service

[Service]
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/trading-agent
ExecStart=/home/trader/apps/trading-agent/node_modules/.bin/tsx scripts/sweep-lighter-microstructure.ts --mode exploratory --db data/lighter-native-microstructure.sqlite --audit data/lighter-native-microstructure-audit.json --output data/lighter-native-microstructure-exploratory.json
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/apps/trading-agent/data
MemoryMax=512M
