[Unit]
Description=Export frozen Lighter Native execution-cost calibration
After=lighter-native-microstructure-audit.service

[Service]
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/trading-agent
ExecStart=/home/trader/apps/trading-agent/node_modules/.bin/tsx scripts/export-lighter-native-execution-costs.ts --audit data/lighter-native-microstructure-audit.json --output data/lighter-execution-costs-native-frozen.json
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/apps/trading-agent/data
MemoryMax=256M
