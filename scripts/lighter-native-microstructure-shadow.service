[Unit]
Description=Prospective Lighter microstructure Shadow accounting
After=lighter-native-microstructure.service lighter-native-microstructure-shadow-prepare.service

[Service]
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/trading-agent
ExecStart=/home/trader/apps/trading-agent/node_modules/.bin/tsx scripts/run-lighter-microstructure-shadow.ts --db data/lighter-native-microstructure.sqlite --core-frozen data/lighter-native-microstructure-sweep.json --challenger-frozen data/lighter-native-microstructure-challenger-sweep.json --manifest data/lighter-native-microstructure-shadow-manifest.json --promotion-audit data/lighter-native-microstructure-promotion-audit.json --output data/lighter-native-microstructure-shadow-report.json
ExecStartPost=/home/trader/apps/trading-agent/node_modules/.bin/tsx scripts/audit-lighter-microstructure-promotion.ts --shadow data/lighter-native-microstructure-shadow-report.json --data-audit data/lighter-native-microstructure-audit.json --output data/lighter-native-microstructure-promotion-audit.json
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trader/apps/trading-agent/data
MemoryMax=512M
